{
  "crons": [{ "path": "/api/cleanup", "schedule": "0 3 * * *" }],
  "headers": [
    { "source": "/(.*)\\.(html|js|css)", "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }] },
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }] }
  ]
}
